# Annapoorna POS configuration.
# On first start this file is copied to .env and the secrets below are replaced
# with random values. Edit .env, not this file.

# Web address port. Tablets on the same Wi-Fi use http://<this-pc-ip>:PORT
PORT=4100

# Which network the app listens on. 0.0.0.0 = tablets on the same Wi-Fi can
# connect (café PC). 127.0.0.1 = only Caddy/Nginx on this server can (hosting).
# HOST=0.0.0.0

# Built-in database (PostgreSQL runs from the data/ folder, no install needed).
PG_PORT=54329
PG_PASSWORD=__generate__

# To use your own PostgreSQL server instead, set DATABASE_URL and the built-in
# database will not be started.
# DATABASE_URL=postgresql://user:password@localhost:5432/annapoorna

# Hosting behind a proxy: which proxy to trust for the visitor's address/https.
# loopback = Nginx/Caddy on the same server (default). 1 = one hop in front,
# e.g. Cloudflare or a cloud load balancer.
# TRUST_PROXY=loopback

# Signs login sessions. Keep it secret.
SESSION_SECRET=__generate__

# What the database starts with on the very first start (empty database only).
#   demo  = the demo café: demo staff, menu, tables and 60 days of sales (default)
#   clean = a real outlet: only an owner account "admin". Its password is
#           ADMIN_PASSWORD (8+ characters); if blank, one is generated and
#           written to data/FIRST-LOGIN.txt. ADMIN_PIN (exactly 4 digits) is optional.
# FIRST_RUN_DATA=demo
# ADMIN_PASSWORD=
# ADMIN_PIN=

# Password and PINs given to the demo staff accounts when the database is
# seeded (first start or `npm run reset`). Change them after going live.
DEMO_PASSWORD=Annapoorna@2026
DEMO_PIN_ADMIN=1111
DEMO_PIN_MANAGER=2222
DEMO_PIN_CASHIER=3333
DEMO_PIN_KITCHEN=4444
DEMO_PIN_WAITER=5555
